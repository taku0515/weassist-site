---
import Layout from '../layouts/Layout.astro';
import { SITE_DATA } from '../data/site';
import MiniIcon from '../components/MiniIcon.astro';
// ▼ 画像最適化コンポーネントをインポート
import { Image } from 'astro:assets';

// サービスの詳細データ
const services = [
  {
    id: "system",
    title: "Webシステム開発",
    icon: "system" as const,
    description: "業務効率化のための社内システムから、一般ユーザー向けのWebサービスまで、幅広く開発します。",
    problems: ["Excelと紙の管理が限界にきている", "既製ソフトが業務に合わない", "見積もりが高額で断念した"],
    features: ["モダンな技術選定 (React/Next.js/Astro)", "クラウドネイティブな設計", "アジャイル開発による柔軟な対応"],
    image: "/illustrations/service-web.webp"
  },
  {
    id: "ai",
    title: "AIソリューション導入",
    icon: "ai" as const,
    description: "ChatGPT等の生成AIを活用した業務自動化や、社内データの分析基盤構築を支援します。機密データを外部に出さないローカルAI構成も選べます。",
    problems: ["AIを使いたいが何から始めるべきか分からない", "機密情報をクラウドAIに入れられない", "定型作業に時間を取られている"],
    features: ["ローカルLLM構築（データを社外に出さない）", "RAG（社内データ検索）構築", "文書作成・報告業務の自動化"],
    image: "/illustrations/service-ai.webp"
  },
  {
    id: "dx",
    title: "DXコンサルティング",
    icon: "dx" as const,
    description: "「何から始めればいいかわからない」という段階から伴走し、デジタル化による課題解決をサポートします。",
    problems: ["IT担当者がいない・兼任で手が回らない", "ツールを入れたが定着しなかった", "何をデジタル化すべきか整理できていない"],
    features: ["現状の業務フロー分析", "最適なツールの選定・導入", "社内定着までのトレーニング"],
    image: "/illustrations/service-dx.webp"
  }
];

// 納品までの流れ
const flow = [
  { step: "01", title: "ヒアリング", desc: "お客様の現状の課題や、実現したいゴールを詳しくお伺いします。" },
  { step: "02", title: "ご提案・お見積り", desc: "課題解決に最適なプランと、概算の費用・スケジュールをご提示します。" },
  { step: "03", title: "要件定義・設計", desc: "具体的な画面イメージや機能を決定し、開発の設計図を作成します。" },
  { step: "04", title: "開発・実装", desc: "アジャイルな手法を取り入れ、進捗を共有しながら開発を進めます。" },
  { step: "05", title: "テスト・納品", desc: "厳密な動作検証を行い、問題がないことを確認した上で本番環境へ公開します。" },
  { step: "06", title: "保守・運用", desc: "公開後の不具合対応や、機能追加などのサポートも継続して行います。" },
];
---

<Layout title="事業内容" description="Webシステム開発、AI導入支援、DXコンサルティングなど、当社の提供するサービス詳細についてご案内します。">
  
  <section class="relative bg-slate-950 py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-[0.07]"></div>
    <span class="watermark top-4 -right-6" aria-hidden="true">SERVICE</span>
    <div class="container mx-auto px-6 relative z-10">
      <h1 class="text-5xl md:text-7xl font-black tracking-tight text-white">Service</h1>
      <p class="mt-4 text-slate-400 font-bold">事業内容 — ビジネスを加速させる3つのソリューション</p>
    </div>
  </section>

  <section class="relative py-20 md:py-28 bg-slate-900 overflow-hidden">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-[0.07]"></div>
    <div class="container mx-auto px-6 max-w-6xl relative z-10">
      
      <div class="space-y-24">
        {services.map((service, index) => (
          <div id={service.id} class={`flex flex-col md:flex-row gap-10 md:gap-16 items-center ${index % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
            
            <div class="w-full md:w-1/2">
              <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-blue-950/40 ring-1 ring-slate-700/60 group">
                <Image
                  src={service.image} 
                  alt={service.title} 
                  width={800}
                  height={450}
                  class="w-full aspect-video object-cover transform group-hover:scale-105 transition-transform duration-700"
                />

              </div>
            </div>

            <div class="w-full md:w-1/2">
              <div class="flex items-center gap-4 mb-4">
                {/* 設計図調イラストと世界観を揃えたダークタイル */}
                <div class="w-16 h-16 rounded-2xl bg-slate-900 bg-[radial-gradient(circle_at_30%_25%,rgba(37,99,235,0.4),transparent_70%)] ring-1 ring-cyan-400/25 shadow-lg shadow-slate-900/25 flex items-center justify-center shrink-0">
                  <MiniIcon name={service.icon} class="w-9 h-9" />
                </div>
                <h2 class="text-3xl font-bold text-white">{service.title}</h2>
              </div>
              <p class="text-slate-400 text-lg leading-relaxed mb-6">
                {service.description}
              </p>

              <div class="mb-6">
                <p class="text-sm font-bold text-slate-400 mb-3">こんな課題ありませんか？</p>
                <div class="flex flex-wrap gap-2">
                  {service.problems.map((p) => (
                    <span class="px-3 py-1.5 bg-slate-800/60 border border-slate-700 text-slate-300 text-xs font-semibold rounded-full">
                      {p}
                    </span>
                  ))}
                </div>
              </div>

              <div class="bg-slate-800/40 rounded-xl p-6 border border-slate-700/60">
                <h3 class="font-bold text-white mb-4 flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                  主な特徴
                </h3>
                <ul class="space-y-3">
                  {service.features.map((feature) => (
                    <li class="flex items-start gap-3 text-slate-300">
                      <span class="w-1.5 h-1.5 bg-cyan-400 rounded-full mt-2 shrink-0"></span>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <section class="relative py-20 md:py-28 bg-slate-950 overflow-hidden">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-[0.07]"></div>
    <span class="watermark top-4 -left-6" aria-hidden="true">FLOW</span>
    <div class="container mx-auto px-6 max-w-5xl relative z-10">
      <div class="mb-14 md:mb-16">
        <span class="block font-mono text-cyan-400 text-base md:text-lg tracking-widest mb-1">Work Flow</span>
        <h2 class="text-4xl md:text-5xl font-black tracking-tight text-white">ご依頼の流れ</h2>
        <p class="mt-3 text-slate-400 font-bold">お問い合わせから納品、その後の運用までトータルでサポートします</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {flow.map((item, i) => (
          <div class="bg-slate-800/40 p-8 rounded-xl border border-slate-700/60 relative overflow-hidden group md:hover:-translate-y-1 md:hover:border-cyan-500/40 transition-all duration-300">
            <div class="text-6xl font-black text-slate-800/70 absolute top-[-10px] right-[-10px] select-none">
              {item.step}
            </div>
            <h3 class="text-xl font-bold text-white mb-3 relative z-10 flex items-center gap-3">
              <span class="text-cyan-300 text-sm font-mono border border-cyan-500/30 px-2 py-0.5 rounded bg-cyan-500/10">{item.step}</span>
              {item.title}
            </h3>
            <p class="text-slate-400 text-sm leading-relaxed relative z-10">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-20 md:py-28 bg-slate-900 overflow-hidden">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-[0.07]"></div>
    <span class="watermark top-4 -right-6" aria-hidden="true">PRICING</span>
    <div class="container mx-auto px-6 max-w-5xl relative z-10">
      <div class="mb-14 md:mb-16">
        <span class="block font-mono text-cyan-400 text-base md:text-lg tracking-widest mb-1">Pricing</span>
        <h2 class="text-4xl md:text-5xl font-black tracking-tight text-white">料金の考え方</h2>
        <p class="mt-3 text-slate-400 font-bold">開発内容によって費用は大きく変わるため、一律料金は設けていません。その代わり、次の3つをお約束します</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="p-8 bg-slate-800/40 rounded-2xl border border-slate-700/60 text-center">
          <div class="w-20 h-20 mx-auto mb-5 rounded-2xl bg-slate-900 bg-[radial-gradient(circle_at_30%_25%,rgba(37,99,235,0.4),transparent_70%)] ring-1 ring-cyan-400/25 shadow-lg shadow-slate-900/25 flex items-center justify-center">
            <MiniIcon name="consult" class="w-11 h-11" />
          </div>
          <h3 class="text-lg font-bold text-white mb-3">相談・お見積りは無料</h3>
          <p class="text-slate-400 text-sm leading-relaxed">課題の整理段階からのご相談も歓迎です。お見積り後に契約を迫ることはありません。</p>
        </div>
        <div class="p-8 bg-slate-800/40 rounded-2xl border border-slate-700/60 text-center">
          <div class="w-20 h-20 mx-auto mb-5 rounded-2xl bg-slate-900 bg-[radial-gradient(circle_at_30%_25%,rgba(37,99,235,0.4),transparent_70%)] ring-1 ring-cyan-400/25 shadow-lg shadow-slate-900/25 flex items-center justify-center">
            <MiniIcon name="small-start" class="w-11 h-11" />
          </div>
          <h3 class="text-lg font-bold text-white mb-3">スモールスタート</h3>
          <p class="text-slate-400 text-sm leading-relaxed">まず小さく作って効果を確認してから広げる進め方を推奨。初期費用を抑えて始められます。</p>
        </div>
        <div class="p-8 bg-slate-800/40 rounded-2xl border border-slate-700/60 text-center">
          <div class="w-20 h-20 mx-auto mb-5 rounded-2xl bg-slate-900 bg-[radial-gradient(circle_at_30%_25%,rgba(37,99,235,0.4),transparent_70%)] ring-1 ring-cyan-400/25 shadow-lg shadow-slate-900/25 flex items-center justify-center">
            <MiniIcon name="scope" class="w-11 h-11" />
          </div>
          <h3 class="text-lg font-bold text-white mb-3">事前に範囲と費用を明示</h3>
          <p class="text-slate-400 text-sm leading-relaxed">着手前に作業範囲・金額・スケジュールを書面でご提示。後から想定外の請求が発生しない進め方をします。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-20 md:py-28 bg-slate-950 overflow-hidden border-t border-slate-800/60">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-20"></div>
    <span class="watermark top-6 -left-6" aria-hidden="true">CONTACT</span>
    <div class="container mx-auto px-6 text-center relative z-10">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-6 [text-wrap:balance]">
        プロジェクトのご相談はこちら
      </h2>

      <p class="text-slate-300 mb-10 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        具体的な要件が決まっていなくても大丈夫です。<br class="hidden md:inline" />
        まずは現状の課題についてお聞かせください。
      </p>

      <a href="/contact" class="inline-block px-10 py-5 bg-white text-slate-900 font-bold text-lg rounded-full shadow-lg hover:bg-blue-50 transition-all hover:-translate-y-1 hover:shadow-blue-900/50">
        お問い合わせフォームへ
      </a>
    </div>
  </section>

</Layout>