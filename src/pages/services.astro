---
import Layout from '../layouts/Layout.astro';
import { SITE_DATA } from '../data/site';
// ▼ 画像最適化コンポーネントをインポート
import { Image } from 'astro:assets';

// サービスの詳細データ
const services = [
  {
    id: "system",
    title: "Webシステム開発",
    icon: "💻",
    description: "業務効率化のための社内システムから、一般ユーザー向けのWebサービスまで、幅広く開発します。",
    features: ["モダンな技術選定 (React/Next.js/Astro)", "クラウドネイティブな設計", "アジャイル開発による柔軟な対応"],
    image: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=800&q=80"
  },
  {
    id: "ai",
    title: "AIソリューション導入",
    icon: "🧠",
    description: "ChatGPT等の生成AIを活用した業務自動化や、社内データの分析基盤構築を支援します。",
    features: ["RAG（社内データ検索）構築", "AIチャットボット開発", "データ分析・可視化"],
    image: "https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=800&q=80"
  },
  {
    id: "dx",
    title: "DXコンサルティング",
    icon: "📊",
    description: "「何から始めればいいかわからない」という段階から伴走し、デジタル化による課題解決をサポートします。",
    features: ["現状の業務フロー分析", "最適なツールの選定・導入", "社内定着までのトレーニング"],
    image: "https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=800&q=80"
  }
];

// 納品までの流れ
const flow = [
  { step: "01", title: "ヒアリング", desc: "お客様の現状の課題や、実現したいゴールを詳しくお伺いします。" },
  { step: "02", title: "ご提案・お見積り", desc: "課題解決に最適なプランと、概算の費用・スケジュールをご提示します。" },
  { step: "03", title: "要件定義・設計", desc: "具体的な画面イメージや機能を決定し、開発の設計図を作成します。" },
  { step: "04", title: "開発・実装", desc: "アジャイルな手法を取り入れ、進捗を共有しながら開発を進めます。" },
  { step: "05", title: "テスト・納品", desc: "厳密な動作検証を行い、問題がないことを確認した上で本番環境へ公開します。" },
  { step: "06", title: "保守・運用", desc: "公開後の不具合対応や、機能追加などのサポートも継続して行います。" },
];
---

<Layout title={`事業内容 | ${SITE_DATA.name}`} description="Webシステム開発、AI導入支援、DXコンサルティングなど、当社の提供するサービス詳細についてご案内します。">
  
  <section class="bg-slate-900 text-white py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-10"></div>
    <div class="container mx-auto px-6 relative z-10 text-center">
      <span class="text-blue-400 font-bold tracking-wider uppercase text-sm mb-2 block">Our Services</span>
      <h1 class="text-4xl md:text-5xl font-bold mb-4 tracking-tight">事業内容</h1>
      <p class="text-slate-400 text-lg">ビジネスを加速させる3つのソリューション</p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 max-w-6xl">
      
      <div class="space-y-24">
        {services.map((service, index) => (
          <div id={service.id} class={`flex flex-col md:flex-row gap-10 md:gap-16 items-center ${index % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
            
            <div class="w-full md:w-1/2">
              <div class="relative rounded-2xl overflow-hidden shadow-2xl group">
                <div class="absolute inset-0 bg-blue-900/20 group-hover:bg-transparent transition-colors duration-500 z-10"></div>
                
                <Image 
                  src={service.image} 
                  alt={service.title} 
                  width={800}
                  height={450}
                  class="w-full aspect-video object-cover transform group-hover:scale-105 transition-transform duration-700"
                />

              </div>
            </div>

            <div class="w-full md:w-1/2">
              <div class="flex items-center gap-3 mb-4">
                <span class="text-4xl">{service.icon}</span>
                <h2 class="text-3xl font-bold text-slate-900">{service.title}</h2>
              </div>
              <p class="text-slate-600 text-lg leading-relaxed mb-8">
                {service.description}
              </p>
              
              <div class="bg-slate-50 rounded-xl p-6 border border-slate-100">
                <h3 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                  主な特徴
                </h3>
                <ul class="space-y-3">
                  {service.features.map((feature) => (
                    <li class="flex items-start gap-3 text-slate-600">
                      <span class="w-1.5 h-1.5 bg-blue-500 rounded-full mt-2 shrink-0"></span>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="text-center mb-16">
        <span class="text-blue-600 font-bold tracking-wider uppercase text-sm">Work Flow</span>
        <h2 class="text-3xl font-bold text-slate-900 mt-2">ご依頼の流れ</h2>
        <p class="mt-4 text-slate-600">お問い合わせから納品、その後の運用までトータルでサポートします。</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {flow.map((item, i) => (
          <div class="bg-white p-8 rounded-xl shadow-sm border border-slate-100 relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300">
            <div class="text-6xl font-black text-slate-100 absolute top-[-10px] right-[-10px] select-none group-hover:text-blue-50 transition-colors">
              {item.step}
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3 relative z-10 flex items-center gap-3">
              <span class="text-blue-600 text-sm font-mono border border-blue-200 px-2 py-0.5 rounded bg-blue-50">{item.step}</span>
              {item.title}
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed relative z-10">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-blue-600">
    <div class="container mx-auto px-6 text-center text-white">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        プロジェクトのご相談はこちら
      </h2>
      <p class="text-blue-100 mb-10 text-lg max-w-2xl mx-auto">
        具体的な要件が決まっていなくても大丈夫です。<br />
        まずは現状の課題についてお聞かせください。
      </p>
      <a href="/contact" class="inline-block px-10 py-5 bg-white text-blue-600 font-bold text-lg rounded-full shadow-lg hover:bg-blue-50 transition-all hover:-translate-y-1">
        お問い合わせフォームへ
      </a>
    </div>
  </section>

</Layout>