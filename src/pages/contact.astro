---
import Layout from '../layouts/Layout.astro';
import FormSpamGuard from '../components/Common/FormSpamGuard.astro';
import { SITE_DATA } from '../data/site';

---

<Layout title="お問い合わせ">

  <div class="relative bg-slate-950 overflow-hidden min-h-[80vh]">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-[0.07]"></div>
    <span class="watermark top-4 -right-6" aria-hidden="true">CONTACT</span>

    <div class="max-w-2xl mx-auto px-6 py-20 relative z-10">
      <div class="mb-10">
        <h1 class="text-5xl md:text-6xl font-black tracking-tight text-white">Contact</h1>
        <p class="mt-4 text-slate-400 font-bold">お問い合わせ — ご相談・お見積りは無料です</p>
      </div>

      {/* 送信先はPages Function（/api/contact）。Turnstile検証を通ったものだけFormspreeへ転送される */}
      <form action="/api/contact" method="POST" class="space-y-6 bg-slate-900/70 p-8 rounded-xl border border-slate-700/60 shadow-2xl shadow-blue-950/30">

        <div>
          <label for="name" class="block text-sm font-bold text-slate-300 mb-2">お名前</label>
          <input type="text" name="name" id="name" required class="w-full px-4 py-3 rounded-lg bg-slate-800/70 text-white border border-slate-600 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/30 outline-none transition-all" />
        </div>

        <div>
          <label for="email" class="block text-sm font-bold text-slate-300 mb-2">メールアドレス</label>
          <input type="email" name="email" id="email" required class="w-full px-4 py-3 rounded-lg bg-slate-800/70 text-white border border-slate-600 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/30 outline-none transition-all" />
        </div>

        <div>
          <label for="message" class="block text-sm font-bold text-slate-300 mb-2">お問い合わせ内容</label>
          <textarea name="message" id="message" rows="5" required class="w-full px-4 py-3 rounded-lg bg-slate-800/70 text-white border border-slate-600 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/30 outline-none transition-all"></textarea>
        </div>

        <FormSpamGuard />

        <button type="submit" class="w-full bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-500 hover:to-cyan-400 text-white font-bold py-4 rounded-lg shadow-lg shadow-blue-900/50 hover:shadow-xl transition-all transform hover:-translate-y-0.5">
          送信する
        </button>

      </form>
    </div>
  </div>
</Layout>