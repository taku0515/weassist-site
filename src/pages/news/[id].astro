---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { SITE_DATA } from '../../data/site';

// ビルド時に記事ごとのページを生成する（下書きは除外）
export async function getStaticPaths() {
  const news = await getCollection('news', ({ data }) => !data.draft);
  return news.map((entry) => ({
    params: { id: entry.id }, // URLになる部分 (/news/これ)
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.title}>
  <div class="relative bg-slate-950 overflow-hidden">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-[0.07]"></div>
    <div class="container mx-auto px-6 py-20 max-w-4xl relative z-10">
      <header class="mb-10 border-b border-slate-800 pb-6">
        <div class="text-slate-500 font-mono mb-4">
          {entry.data.date.toLocaleDateString('ja-JP')}
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-white leading-tight">
          {entry.data.title}
        </h1>
        {entry.data.category && (
          <span class="inline-block mt-4 bg-cyan-500/10 text-cyan-300 text-xs font-semibold px-2.5 py-0.5 rounded">
            {entry.data.category}
          </span>
        )}
      </header>

      <article class="prose prose-invert lg:prose-xl max-w-none">
        <Content />
      </article>

      <div class="mt-16 pt-8 border-t border-slate-800">
        <a href="/news" class="inline-flex items-center text-cyan-300 hover:text-cyan-200 font-bold">
          &larr; お知らせ一覧に戻る
        </a>
      </div>
    </div>
  </div>
</Layout>
