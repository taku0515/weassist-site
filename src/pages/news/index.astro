---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE_DATA } from '../../data/site';

// Markdown（src/content/news/）からお知らせ一覧を取得（下書きは除外、日付降順）
const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="お知らせ">

  <section class="relative bg-slate-950 py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-[0.07]"></div>
    <span class="watermark top-4 -right-6" aria-hidden="true">NEWS</span>
    <div class="container mx-auto px-6 relative z-10">
      <h1 class="text-5xl md:text-7xl font-black tracking-tight text-white">News</h1>
      <p class="mt-4 text-slate-400 font-bold">お知らせ</p>
    </div>
  </section>

  <section class="relative py-20 bg-slate-900 overflow-hidden min-h-[40vh]">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-[0.07]"></div>
    <div class="container mx-auto px-6 max-w-5xl relative z-10">
      <ul class="space-y-4">
        {news.length === 0 ? <p class="text-slate-400">現在お知らせはありません。</p> : null}

        {news.map((item) => (
          <li>
            <a href={`/news/${item.id}`} class="flex flex-col md:flex-row md:items-center gap-4 p-6 rounded-xl bg-slate-800/40 border border-slate-700/60 hover:border-cyan-500/40 hover:bg-slate-800/70 transition-all group">
              <time class="text-slate-500 font-mono">
                {item.data.date.toLocaleDateString('ja-JP')}
              </time>
              <h2 class="text-lg font-bold text-slate-200 group-hover:text-cyan-300 transition-colors flex-1">{item.data.title}</h2>
              <span class="text-cyan-300 text-sm font-bold">詳細を見る &rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
