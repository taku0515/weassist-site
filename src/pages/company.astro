---
import Layout from '../layouts/Layout.astro';
import { SITE_DATA } from '../data/site';
import { Icon } from 'astro-icon/components';

// 会社情報のデータを SITE_DATA から参照して構築
const companyProfile = [
  { label: "会社名", value: SITE_DATA.name },
  { label: "代表", value: SITE_DATA.president },
  { label: "設立", value: SITE_DATA.established },
  /*{ label: "資本金", value: SITE_DATA.capital },*/
  { label: "事業内容", value: "Webシステム開発事業 / AIソリューション事業 / デジタルマーケティング事業" },
  { label: "所在地", value: SITE_DATA.address },
  { label: "主要取引銀行", value: "みずほ銀行 / 三井住友銀行" },
];
---

<Layout title="会社概要" description="当社の会社概要、ミッション、代表挨拶についてご案内します。">

  <section class="bg-slate-900 py-20 text-center">
    <div class="container mx-auto px-6">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Company</h1>
      <p class="text-slate-400 text-lg">会社概要</p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center mb-20">
        <span class="text-blue-600 font-bold tracking-widest uppercase mb-2 block">Mission</span>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6 leading-relaxed">
          テクノロジーで<br class="md:hidden" />「不可能」を「可能」に。
        </h2>
        <p class="text-slate-600 text-lg leading-loose">
          私たちは、最新の技術と創造性を組み合わせることで、
          お客様のビジネスに革新をもたらし、
          社会全体の生産性を向上させることを目指しています。
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {[
          { title: "Innovation", desc: "常に最新技術を追求し、既存の枠にとらわれない解決策を提案します。", icon: "lucide:lightbulb" },
          { title: "Quality", desc: "細部までこだわり抜き、堅牢で使いやすい高品質なプロダクトを提供します。", icon: "lucide:gem" },
          { title: "Partnership", desc: "お客様と同じ視点に立ち、共に成長する長期的なパートナーを目指します。", icon: "lucide:handshake" },
        ].map((value) => (
          <div class="bg-slate-50 p-8 rounded-xl text-center border border-slate-100 hover:border-blue-200 transition-colors">
            <div class="w-14 h-14 mx-auto mb-4 bg-blue-50 rounded-xl flex items-center justify-center">
              <Icon name={value.icon} class="w-7 h-7 text-blue-600" />
            </div>
            <h3 class="text-xl font-bold text-slate-800 mb-3">{value.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{value.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="container mx-auto px-6">
      <div class="flex flex-col md:flex-row items-center gap-12 max-w-5xl mx-auto">
        <div class="w-full md:w-1/3">
          <div class="aspect-[3/4] bg-slate-200 rounded-lg overflow-hidden shadow-lg relative">
             <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="代表写真" class="w-full h-full object-cover" />
          </div>
        </div>
        
        <div class="w-full md:w-2/3">
          <h2 class="text-2xl font-bold text-slate-800 mb-6">
            変化の激しい時代に、<br />
            変わらない信頼を。
          </h2>
          <div class="space-y-4 text-slate-600 leading-loose">
            <p>
              近年、AI技術の急速な発展により、私たちのビジネス環境は劇的な変化を遂げています。しかし、どのような技術も、使うのは「人」であり、解決すべきは「人の悩み」であることに変わりはありません。
            </p>
            <p>
              当社は設立以来、技術力の向上だけでなく、お客様との対話を何よりも大切にしてまいりました。最新のテクノロジーを、誰もが使いこなせる形でお届けすることこそが、私たちの使命です。
            </p>
            <p>
              今後も、技術の力で社会に貢献できるよう、社員一同邁進してまいります。
            </p>
          </div>
          <div class="mt-8 text-right">
            <p class="text-slate-800 font-bold text-lg">代表</p>
            <p class="text-2xl font-serif text-slate-900 mt-1">{SITE_DATA.president}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="container mx-auto px-6 max-w-4xl">
      <h2 class="text-3xl font-bold text-center mb-12 text-slate-800">Profile</h2>
      
      <dl class="border-t border-slate-200">
        {companyProfile.map((item) => (
          <div class="flex flex-col md:flex-row border-b border-slate-200 py-5">
            <dt class="w-full md:w-48 font-bold text-slate-700 py-1">{item.label}</dt>
            <dd class="flex-1 text-slate-600 py-1">{item.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="h-[400px] w-full bg-slate-200 relative">
    <iframe 
      src="https://maps.google.com/maps?q=%E6%9D%B1%E4%BA%AC%E9%83%BD%E5%8F%B0%E6%9D%B1%E5%8C%BA%E6%B5%85%E8%8D%89&z=15&hl=ja&output=embed"
      width="100%" 
      height="100%" 
      style="border:0;" 
      allowfullscreen="" 
      loading="lazy" 
      referrerpolicy="no-referrer-when-downgrade"
      class="grayscale hover:grayscale-0 transition-all duration-500"
    ></iframe>
  </section>

</Layout>