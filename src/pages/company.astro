---
import Layout from '../layouts/Layout.astro';
import { SITE_DATA } from '../data/site';
import MiniIcon from '../components/MiniIcon.astro';

// 会社情報のデータを SITE_DATA から参照して構築
const companyProfile = [
  { label: "会社名", value: SITE_DATA.name },
  { label: "代表", value: SITE_DATA.president },
  { label: "設立", value: SITE_DATA.established },
  /*{ label: "資本金", value: SITE_DATA.capital },*/
  { label: "事業内容", value: "Webシステム開発事業 / AIソリューション事業 / デジタルマーケティング事業" },
  { label: "所在地", value: SITE_DATA.address },
  { label: "主要取引銀行", value: "みずほ銀行 / 三井住友銀行" },
];
---

<Layout title="会社概要" description="当社の会社概要、ミッション、代表挨拶についてご案内します。">

  <section class="relative bg-slate-950 py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-[0.07]"></div>
    <span class="watermark top-4 -right-6" aria-hidden="true">COMPANY</span>
    <div class="container mx-auto px-6 relative z-10">
      <h1 class="text-5xl md:text-7xl font-black tracking-tight text-white">Company</h1>
      <p class="mt-4 text-slate-400 font-bold">会社概要</p>
    </div>
  </section>

  <section class="relative py-20 md:py-28 bg-slate-900 overflow-hidden">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-[0.07]"></div>
    <span class="watermark top-4 -left-6" aria-hidden="true">MISSION</span>
    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-4xl mx-auto text-center mb-20">
        <span class="text-cyan-400 font-mono font-bold tracking-widest uppercase mb-2 block">Mission</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 leading-relaxed">
          テクノロジーで<br class="md:hidden" />「不可能」を「可能」に。
        </h2>
        <p class="text-slate-400 text-lg leading-loose">
          私たちは、最新の技術と創造性を組み合わせることで、
          お客様のビジネスに革新をもたらし、
          社会全体の生産性を向上させることを目指しています。
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {[
          { title: "Innovation", desc: "常に最新技術を追求し、既存の枠にとらわれない解決策を提案します。", icon: "innovation" as const },
          { title: "Quality", desc: "細部までこだわり抜き、堅牢で使いやすい高品質なプロダクトを提供します。", icon: "quality" as const },
          { title: "Partnership", desc: "お客様と同じ視点に立ち、共に成長する長期的なパートナーを目指します。", icon: "partnership" as const },
        ].map((value) => (
          <div class="bg-slate-800/40 p-8 rounded-xl text-center border border-slate-700/60 md:hover:border-cyan-500/40 transition-colors">
            {/* 設計図調イラストと世界観を揃えたダークタイル */}
            <div class="w-20 h-20 mx-auto mb-5 rounded-2xl bg-slate-900 bg-[radial-gradient(circle_at_30%_25%,rgba(37,99,235,0.4),transparent_70%)] ring-1 ring-cyan-400/25 shadow-lg shadow-slate-950/40 flex items-center justify-center">
              <MiniIcon name={value.icon} class="w-11 h-11" />
            </div>
            <h3 class="text-xl font-bold text-white mb-3">{value.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed">{value.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-20 md:py-28 bg-slate-950 overflow-hidden">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-[0.07]"></div>
    <span class="watermark top-4 -right-6" aria-hidden="true">MESSAGE</span>
    <div class="container mx-auto px-6 relative z-10">
      <div class="flex flex-col md:flex-row items-center gap-12 max-w-5xl mx-auto">
        <div class="w-full md:w-1/3">
          {/* 代表写真（サイトの紺に合わせたネイビーデュオトーン加工済み） */}
          <div class="aspect-[3/4] rounded-lg overflow-hidden shadow-lg relative bg-slate-900 ring-1 ring-slate-700/60">
            <img
              src="/company/representative.webp"
              alt="代表 多久島顕悟"
              width="900"
              height="1200"
              loading="lazy"
              class="absolute inset-0 w-full h-full object-cover"
            />
            {/* 下部を紺にフェードさせて名前を重ねる */}
            <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-slate-950/95 via-slate-950/45 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-5 text-center">
              <p class="text-white font-bold text-lg">多久島 顕悟</p>
              <p class="text-slate-400 text-[11px] tracking-[0.25em] mt-1.5">REPRESENTATIVE</p>
            </div>
          </div>
        </div>
        
        <div class="w-full md:w-2/3">
          <h2 class="text-2xl font-bold text-white mb-6">
            変化の激しい時代に、<br />
            変わらない信頼を。
          </h2>
          <div class="space-y-4 text-slate-400 leading-loose">
            <p>
              近年、AI技術の急速な発展により、私たちのビジネス環境は劇的な変化を遂げています。しかし、どのような技術も、使うのは「人」であり、解決すべきは「人の悩み」であることに変わりはありません。
            </p>
            <p>
              当社は設立以来、技術力の向上だけでなく、お客様との対話を何よりも大切にしてまいりました。最新のテクノロジーを、誰もが使いこなせる形でお届けすることこそが、私たちの使命です。
            </p>
            <p>
              今後も、技術の力で社会に貢献できるよう、社員一同邁進してまいります。
            </p>
          </div>
          <div class="mt-8 text-right">
            <p class="text-slate-300 font-bold text-lg">代表</p>
            <p class="text-2xl font-serif text-white mt-1">{SITE_DATA.president}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-20 md:py-28 bg-slate-900 overflow-hidden">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-[0.07]"></div>
    <span class="watermark top-4 -left-6" aria-hidden="true">PROFILE</span>
    <div class="container mx-auto px-6 max-w-4xl relative z-10">
      <div class="mb-12">
        <span class="block font-mono text-cyan-400 text-base md:text-lg tracking-widest mb-1">Profile</span>
        <h2 class="text-4xl md:text-5xl font-black tracking-tight text-white">会社情報</h2>
      </div>

      <dl class="border-t border-slate-700/60">
        {companyProfile.map((item) => (
          <div class="flex flex-col md:flex-row border-b border-slate-700/60 py-5">
            <dt class="w-full md:w-48 font-bold text-slate-300 py-1">{item.label}</dt>
            <dd class="flex-1 text-slate-400 py-1">{item.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="h-[400px] w-full bg-slate-900 relative border-t border-slate-800/60">
    {/* grayscaleはfilterのためPC限定（スマホはfilterゼロを維持） */}
    <iframe
      src="https://maps.google.com/maps?q=%E6%9D%B1%E4%BA%AC%E9%83%BD%E5%8F%B0%E6%9D%B1%E5%8C%BA%E6%B5%85%E8%8D%89&z=15&hl=ja&output=embed"
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="md:grayscale md:hover:grayscale-0 transition-all duration-500"
    ></iframe>
  </section>

</Layout>