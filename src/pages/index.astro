---
import Layout from '../layouts/Layout.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';
import { getLatestBlogPosts } from '../library/wp';
// Markdown（src/content/news/）から記事を3件だけ取得、公開日順に並び替え
const newsItems = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// トップに載せる実績（featured: true のみ、新しい順に3件）
const featuredWorks = (await getCollection('works', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// 選ばれる理由（イラストは public/illustrations/ の自作SVG）
const reasons = [
  {
    image: '/illustrations/reason-fieldwork.svg',
    title: '現場を知る開発',
    desc: '営業の現場経験を持つ開発者が担当。「システムの都合」ではなく「業務の流れ」に馴染む形で設計します。',
  },
  {
    image: '/illustrations/reason-local-data.svg',
    title: 'データを外に出さない選択肢',
    desc: 'ローカルAIの活用により、機密情報を外部クラウドに送らない構成もご提案できます。セキュリティ要件の厳しい業務でもAIを諦めません。',
  },
  {
    image: '/illustrations/reason-prototype.svg',
    title: '小さく作って、早く形に',
    desc: 'まず動くプロトタイプを素早くお見せし、確認しながら段階的に育てる進め方。大きな初期投資なしで始められます。',
  },
];

// 提供サービス（イラストは services ページと共通）
const topServices = [
  {
    title: 'システム開発',
    desc: '業務効率化システムから、BtoC向けのWebアプリケーションまで。最新のフレームワークを用いた拡張性の高い開発を行います。',
    image: '/illustrations/service-web.svg',
    href: '/services#system',
    color: 'text-blue-600',
  },
  {
    title: 'AI導入・活用支援',
    desc: 'ChatGPTなどの生成AIを活用した業務フローの構築や、社内データのAI分析基盤の整備をサポートします。',
    image: '/illustrations/service-ai.svg',
    href: '/services#ai',
    color: 'text-purple-600',
  },
  {
    title: 'DXコンサルティング',
    desc: 'アナログな業務プロセスのデジタル化を企画から定着まで伴走支援。ツールの導入だけでなく、組織の変革をお手伝いします。',
    image: '/illustrations/service-dx.svg',
    href: '/services#dx',
    color: 'text-emerald-600',
  },
];

// ブログ（web.weassist.jp）の最新記事をビルド時に取得
const blogPosts = await getLatestBlogPosts();

// 技術マーキーに流すタグ（実際に使っている技術のみ）
const techTags = [
  'Python', 'Flask', 'Vue 3', 'Astro', 'PostgreSQL', 'Ollama',
  'faster-whisper', 'VOICEVOX', 'ローカルLLM', 'RAG', 'Tailwind CSS',
  'Cloudflare Pages', 'WordPress', 'Git',
];
---


<Layout title="未来を創るITパートナー">
  
  <section class="relative bg-slate-900 text-white overflow-hidden min-h-[800px] flex items-center">

    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] bg-blue-600 rounded-full blur-[120px] opacity-30 md:opacity-40 animate-blob"></div>
      <div class="absolute top-[20%] right-[-10%] w-[400px] h-[400px] bg-cyan-500 rounded-full blur-[100px] opacity-25 md:opacity-30 animate-blob animation-delay-2000"></div>

      <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-10"></div>
      <canvas id="hero-net" class="absolute inset-0 w-full h-full opacity-60"></canvas>
    </div>

    <div class="container mx-auto px-6 grid md:grid-cols-2 gap-12 items-center relative z-10">
      
      <div class="space-y-8 text-center md:text-left">
        
