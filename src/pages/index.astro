<style>
  /* --- アニメーションの定義 --- */

  /* 1. オーロラのように動く（blob） */
  @keyframes blob {
    0% { transform: translate(0px, 0px) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
    100% { transform: translate(0px, 0px) scale(1); }
  }
  .animate-blob {
    animation: blob 7s infinite;
  }
  .animation-delay-2000 {
    animation-delay: 2s;
  }
  .animation-delay-4000 {
    animation-delay: 4s;
  }

  /* 2. ふわふわ浮く（float） */
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
    100% { transform: translateY(0px); }
  }
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  /* 3. カーソルの点滅 */
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  .animate-blink {
    animation: blink 1s step-end infinite;
  }

  /* 4. ふわっと現れる */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0; /* 初期状態は隠す */
  }
  .delay-100 { animation-delay: 0.1s; }
  .delay-200 { animation-delay: 0.2s; }

  /* 5. 技術タグのマーキー（同じ列を2回並べて -50% 移動でループ） */
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .marquee {
    animation: marquee 35s linear infinite;
  }

  /* 6. スクロールで現れるセクション */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.45s ease-out, transform 0.45s ease-out;
  }
  .reveal.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* 動きを減らす設定のユーザーにはアニメーションを止める */
  @media (prefers-reduced-motion: reduce) {
    .marquee { animation: none; }
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // タイマーのIDを管理する変数（二重起動防止用）
  let typeTimeoutId: number | undefined;

  // astro:page-load は、最初の表示＋ページ移動して戻ってきた時にも実行されます
  document.addEventListener('astro:page-load', () => {
    
    // 1. タイプライターを表示する場所を探す
    const textElement = document.querySelector('.typewriter') as HTMLElement | null;
    
    // もしこのページにタイプライター要素がなければ何もしない（他のページでのエラー防止）
    if (!textElement) return;

    // 2. 変数の初期化
    const texts = ["加速させる", "変革する", "創造する"];
    let textIndex = 0;
    let charIndex = 0;
    let isDeleting = false;

    // 3. 前のループが残っていたら止める（重要！）
    if (typeTimeoutId) clearTimeout(typeTimeoutId);

    // 4. タイプライター関数
    function type() {
      // 実行する瞬間に、まだその要素が画面にあるかチェック
      // (別のページに移動していたら停止させる)
      if (!textElement || !document.body.contains(textElement)) return;

      const currentText = texts[textIndex];
      
      if (isDeleting) {
        textElement.textContent = currentText.substring(0, charIndex - 1);
        charIndex--;
      } else {
        textElement.textContent = currentText.substring(0, charIndex + 1);
        charIndex++;
      }

      let typeSpeed = isDeleting ? 100 : 200;

      if (!isDeleting && charIndex === currentText.length) {
        // 打ち終わったら少し待機
        typeSpeed = 2000;
        isDeleting = true;
      } else if (isDeleting && charIndex === 0) {
        // 消し終わったら次の言葉へ
        isDeleting = false;
        textIndex = (textIndex + 1) % texts.length;
        typeSpeed = 500;
      }

      // 次の動作を予約し、その予約IDを保存しておく
      typeTimeoutId = setTimeout(type, typeSpeed) as unknown as number;
    }

    // 5. スタート！
    type();
  });
</script>

<script>
  // ============================================
  // ローカルAIコンソールのタイプ演出
  // ============================================
  let consoleTimeoutId: number | undefined;

  const CONSOLE_LINES = [
    { type: 'cmd', text: '今日の会議メモ、要点だけまとめて日報にして' },
    { type: 'ai', text: '完了しました。要点を3行に整理し、日報に追記しています。' },
    { type: 'cmd', text: 'このやり取り、クラウドに送信してる？' },
    { type: 'ai', text: 'いいえ。音声認識も文章生成も、すべてこのPCの中で完結しています。' },
    { type: 'sys', text: '── weassist のローカルAIは、データを外に出しません ──' },
  ];

  document.addEventListener('astro:page-load', () => {
    const box = document.getElementById('ai-console');
    if (!box) return;
    if (consoleTimeoutId) clearTimeout(consoleTimeoutId);

    const schedule = (fn: () => void, ms: number) => {
      consoleTimeoutId = setTimeout(fn, ms) as unknown as number;
    };

    const makeLine = (type: string) => {
      const line = document.createElement('div');
      const prefix = document.createElement('span');
      const body = document.createElement('span');
      if (type === 'cmd') {
        prefix.textContent = '❯ ';
        prefix.className = 'text-cyan-400';
        body.className = 'text-slate-100';
      } else if (type === 'ai') {
        prefix.textContent = '✓ ';
        prefix.className = 'text-emerald-400';
        body.className = 'text-slate-300';
      } else {
        line.className = 'text-slate-500 text-xs text-center pt-2';
      }
      line.append(prefix, body);
      box.appendChild(line);
      return body;
    };

    const run = (lineIdx: number) => {
      if (!document.body.contains(box)) return;
      if (lineIdx >= CONSOLE_LINES.length) {
        // 一巡したらしばらく見せてからリセット
        schedule(() => { box.innerHTML = ''; run(0); }, 6000);
        return;
      }
      const { type, text } = CONSOLE_LINES[lineIdx];
      const body = makeLine(type);
      let charIdx = 0;
      const typeChar = () => {
        if (!document.body.contains(box)) return;
        body.textContent = text.slice(0, ++charIdx);
        if (charIdx < text.length) {
          schedule(typeChar, type === 'cmd' ? 55 : 22);
        } else {
          schedule(() => run(lineIdx + 1), 750);
        }
      };
      typeChar();
    };

    box.innerHTML = '';
    run(0);
  });
</script>

<script>
  // ============================================
  // ヒーロー背景のパーティクル・ネットワーク
  // ============================================
  let netRafId: number | undefined;

  document.addEventListener('astro:page-load', () => {
    const canvas = document.getElementById('hero-net') as HTMLCanvasElement | null;
    if (!canvas) return;
    if (netRafId) cancelAnimationFrame(netRafId);
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const resize = () => {
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
    };
    resize();
    window.addEventListener('resize', resize);

    const COUNT = 32;
    const LINK_DIST = 140;
    const FRAME_MS = 33; // 約30fpsに間引く（60fpsとの見た目差はほぼ無い）
    const nodes = Array.from({ length: COUNT }, () => ({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      vx: (Math.random() - 0.5) * 0.5,
      vy: (Math.random() - 0.5) * 0.5,
    }));

    // ヒーローが画面外にある間は描画を完全停止する
    let visible = true;
    const visObserver = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
    });
    visObserver.observe(canvas);

    let lastFrame = 0;
    const draw = (now: number) => {
      if (!document.body.contains(canvas)) return;
      netRafId = requestAnimationFrame(draw);
      if (!visible || now - lastFrame < FRAME_MS) return;
      lastFrame = now;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      for (const n of nodes) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0 || n.x > canvas.width) n.vx *= -1;
        if (n.y < 0 || n.y > canvas.height) n.vy *= -1;
      }

      for (let i = 0; i < COUNT; i++) {
        for (let j = i + 1; j < COUNT; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const dist = Math.hypot(dx, dy);
          if (dist < LINK_DIST) {
            ctx.strokeStyle = `rgba(34, 211, 238, ${0.14 * (1 - dist / LINK_DIST)})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }
      }

      ctx.fillStyle = 'rgba(96, 165, 250, 0.5)';
      for (const n of nodes) {
        ctx.beginPath();
        ctx.arc(n.x, n.y, 1.6, 0, Math.PI * 2);
        ctx.fill();
      }
    };
    netRafId = requestAnimationFrame(draw);
  });
</script>

<script>
  // ============================================
  // スクロールで現れるセクション（IntersectionObserver）
  // ============================================
  document.addEventListener('astro:page-load', () => {
    const targets = document.querySelectorAll('.reveal');
    if (!targets.length) return;

    // threshold: 0 + rootMargin で「画面に入る120px手前」から表示を開始する。
    // 縦長セクション（スマホの選ばれる理由など）でも空白の間が生まれない
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0, rootMargin: '0px 0px 120px 0px' }
    );
    targets.forEach((t) => observer.observe(t));
  });
</script>