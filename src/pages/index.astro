---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';
// Markdown（src/content/news/）から記事を3件だけ取得、公開日順に並び替え
const newsItems = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// トップに載せる実績（featured: true のみ、新しい順に3件）
const featuredWorks = (await getCollection('works', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// 選ばれる理由（イラストは public/illustrations/ の自作SVG）
const reasons = [
  {
    image: '/illustrations/reason-fieldwork.svg',
    title: '現場を知る開発',
    desc: '営業の現場経験を持つ開発者が担当。「システムの都合」ではなく「業務の流れ」に馴染む形で設計します。',
  },
  {
    image: '/illustrations/reason-local-data.svg',
    title: 'データを外に出さない選択肢',
    desc: 'ローカルAIの活用により、機密情報を外部クラウドに送らない構成もご提案できます。セキュリティ要件の厳しい業務でもAIを諦めません。',
  },
  {
    image: '/illustrations/reason-prototype.svg',
    title: '小さく作って、早く形に',
    desc: 'まず動くプロトタイプを素早くお見せし、確認しながら段階的に育てる進め方。大きな初期投資なしで始められます。',
  },
];

// 提供サービス（イラストは services ページと共通）
const topServices = [
  {
    title: 'システム開発',
    desc: '業務効率化システムから、BtoC向けのWebアプリケーションまで。最新のフレームワークを用いた拡張性の高い開発を行います。',
    image: '/illustrations/service-web.svg',
    href: '/services#system',
    color: 'text-blue-600',
  },
  {
    title: 'AI導入・活用支援',
    desc: 'ChatGPTなどの生成AIを活用した業務フローの構築や、社内データのAI分析基盤の整備をサポートします。',
    image: '/illustrations/service-ai.svg',
    href: '/services#ai',
    color: 'text-purple-600',
  },
  {
    title: 'DXコンサルティング',
    desc: 'アナログな業務プロセスのデジタル化を企画から定着まで伴走支援。ツールの導入だけでなく、組織の変革をお手伝いします。',
    image: '/illustrations/service-dx.svg',
    href: '/services#dx',
    color: 'text-emerald-600',
  },
];

// 背景画像など（既存のコード）
const heroImage = "/hero.avif";
---


<Layout title="未来を創るITパートナー">
  
  <section class="relative bg-slate-900 text-white overflow-hidden min-h-[800px] flex items-center">
    
    <div class="absolute inset-0 z-0 md:hidden">
      <Image 
        src={heroImage} 
        alt="Background" 
        width={800} 
        height={1200}
        class="w-full h-full object-cover opacity-60" 
      />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900/80 via-slate-900/80 to-slate-900"></div>
    </div>

    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] bg-blue-600 rounded-full blur-[120px] opacity-20 md:opacity-40 animate-blob"></div>
      <div class="absolute top-[20%] right-[-10%] w-[400px] h-[400px] bg-cyan-500 rounded-full blur-[100px] opacity-20 md:opacity-30 animate-blob animation-delay-2000"></div>
      
      <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-10"></div>
    </div>

    <div class="container mx-auto px-6 grid md:grid-cols-2 gap-12 items-center relative z-10">
      
      <div class="space-y-8 text-center md:text-left">
        
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-300 text-sm font-mono animate-fade-in-up mx-auto md:mx-0">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
          </span>
          Next Generation Tech
        </div>

        <h1 class="text-4xl md:text-6xl font-bold leading-tight tracking-tight drop-shadow-lg">
          技術でビジネスを<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300 typewriter"></span>
          <span class="animate-blink">|</span>
        </h1>

        <p class="text-slate-100 md:text-slate-300 text-lg leading-relaxed max-w-lg animate-fade-in-up delay-100 mx-auto md:mx-0 drop-shadow-md">
          最新のAIソリューションとクラウド技術で、御社のデジタルトランスフォーメーションを強力に支援します。確かな技術力で、未来への架け橋に。
        </p>
        
        <div class="pt-4 animate-fade-in-up delay-200">
          <div class="flex flex-wrap gap-4 justify-center md:justify-start animate-float md:!animate-none">

            <a href="/contact" class="px-8 py-4 bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-500 hover:to-cyan-400 text-white rounded-lg font-bold transition-all shadow-lg shadow-blue-900/50 hover:shadow-blue-900/80 hover:-translate-y-1">
              無料で相談する
            </a>
            <a href="/works" class="px-8 py-4 bg-white/5 border border-white/20 hover:bg-white/10 hover:border-white/40 text-white rounded-lg font-bold transition-all backdrop-blur-sm hover:-translate-y-1">
              実績を見る
            </a>

          </div>
        </div>
      </div>

      <div class="relative animate-float hidden md:block">

        <Image 
          src={heroImage}
          alt="Dashboard" 
          width={800} 
          height={600}
          class="rounded-2xl shadow-2xl border border-slate-700 relative z-10 w-full" 
        />
        
        <div class="absolute -bottom-10 -left-10 bg-slate-800/80 backdrop-blur-md p-6 rounded-xl border border-slate-600 shadow-xl z-20 animate-float animation-delay-2000">
          <div class="flex items-center gap-4">
            <div class="bg-green-500/20 p-3 rounded-lg text-green-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <p class="text-sm text-slate-400">Project Status</p>
              <p class="text-xl font-bold text-white">Success</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white text-slate-800">
    <div class="container mx-auto px-6">
      <div class="text-center mb-12">
        <span class="text-blue-600 font-bold tracking-wider uppercase text-sm">Why weassist</span>
        <h2 class="text-3xl md:text-4xl font-bold mt-2">選ばれる理由</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {reasons.map((item) => (
          <div class="bg-slate-50 rounded-2xl border border-slate-100 hover:border-blue-200 hover:shadow-lg transition-all duration-300 group overflow-hidden">
            <div class="overflow-hidden">
              <img
                src={item.image}
                alt=""
                width="400"
                height="260"
                loading="lazy"
                class="w-full h-auto group-hover:scale-[1.03] transition-transform duration-500"
              />
            </div>
            <div class="p-8 pt-6">
              <h3 class="text-xl font-bold mb-3">{item.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="container mx-auto px-6">
      
      <div class="text-center mb-16">
        <span class="text-blue-600 font-bold tracking-wider uppercase text-sm">Our Services</span>
        <h2 class="text-3xl md:text-4xl font-bold mt-2 text-slate-900">提供サービス</h2>
        <p class="mt-4 text-slate-600 max-w-2xl mx-auto">
          お客様の課題に合わせて、最適なテクノロジーソリューションをワンストップで提供します。
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {topServices.map((s) => (
          <a href={s.href} class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 group border border-slate-100 overflow-hidden flex flex-col">
            <div class="overflow-hidden">
              <img
                src={s.image}
                alt=""
                width="800"
                height="450"
                loading="lazy"
                class="w-full h-44 object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-8 flex flex-col grow">
              <h3 class="text-xl font-bold text-slate-900 mb-3">{s.title}</h3>
              <p class="text-slate-600 leading-relaxed mb-6 grow">
                {s.desc}
              </p>
              <span class={`${s.color} font-bold text-sm flex items-center gap-1`}>
                詳しく見る <span class="group-hover:translate-x-1 transition-transform">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <section class="py-20 bg-slate-900 relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-10"></div>
    <div class="absolute top-[-20%] left-[-10%] w-[500px] h-[500px] bg-blue-600 rounded-full blur-[140px] opacity-25"></div>
    <div class="absolute bottom-[-20%] right-[-10%] w-[400px] h-[400px] bg-cyan-500 rounded-full blur-[120px] opacity-20"></div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="text-center mb-16">
        <span class="text-cyan-400 font-bold tracking-wider uppercase text-sm">Works</span>
        <h2 class="text-3xl md:text-4xl font-bold mt-2 text-white">実績</h2>
        <p class="mt-4 text-slate-400 max-w-2xl mx-auto">
          自ら作り、自ら使い続けているプロダクトたち。<br class="md:hidden" />
          「動くもの」でご覧いただけます。
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto mb-12">
        {featuredWorks.map((work) => (
          <WorkCard work={work} dark />
        ))}
      </div>

      <div class="text-center">
        <a href="/works" class="inline-block px-8 py-4 border border-slate-600 text-slate-200 rounded-full font-bold text-sm hover:bg-white/5 hover:border-slate-400 transition-all">
          実績一覧を見る →
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 max-w-4xl">

      <div class="flex items-end justify-between mb-10 border-b border-slate-200 pb-4">
        <div>
          <span class="text-blue-600 font-bold tracking-wider uppercase text-sm">News & Topics</span>
          <h2 class="text-3xl font-bold text-slate-900 mt-1">お知らせ</h2>
        </div>
        <a href="/news" class="text-slate-500 hover:text-blue-600 font-bold text-sm hidden md:block transition-colors">
          一覧を見る →
        </a>
      </div>

      <div class="space-y-4">
        {newsItems.length === 0 ? (
          <p class="text-slate-500">現在お知らせはありません。</p>
        ) : (
          newsItems.map((news) => (
            <a href={`/news/${news.id}`} class="block bg-slate-50 p-6 rounded-xl hover:bg-white hover:shadow-md transition-all border border-slate-100 group">
              <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-6">

                {/* 日付のフォーマット整形（YYYY.MM.DD） */}
                <time class="text-slate-400 font-mono text-sm">
                  {news.data.date.toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '.')}
                </time>

                {/* カテゴリがある場合のみ表示 */}
                {news.data.category && (
                  <span class="inline-block px-3 py-1 bg-blue-100 text-blue-600 text-xs font-bold rounded md:w-auto w-fit">
                    {news.data.category}
                  </span>
                )}

                {/* タイトル */}
                <h3 class="text-slate-800 font-bold group-hover:text-blue-600 transition-colors flex-1">
                  {news.data.title}
                </h3>
                
                <span class="text-slate-300 group-hover:text-blue-600 transition-colors ml-auto">→</span>
              </div>
            </a>
          ))
        )}
      </div>

      <div class="mt-8 text-center md:hidden">
        <a href="/news" class="inline-block px-6 py-3 border border-slate-300 text-slate-600 rounded-full font-bold text-sm hover:bg-slate-50 transition-colors">
          お知らせ一覧へ
        </a>
      </div>

    </div>
  </section>

  <section class="py-20 bg-slate-900 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20 bg-[url('/grid-pattern.svg')]"></div>
    <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500 rounded-full blur-[100px] opacity-20"></div>

    <div class="container mx-auto px-6 text-center relative z-10">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
        ビジネスの課題を、<br class="md:hidden" />技術で解決しませんか？
      </h2>
      <p class="text-slate-300 mb-10 max-w-2xl mx-auto text-lg">
        AI導入やシステム開発に関するご相談は無料です。<br />
        まずはお気軽にお問い合わせください。
      </p>
      <a href="/contact" class="inline-block px-10 py-5 bg-white text-slate-900 font-bold text-lg rounded-full shadow-lg hover:bg-blue-50 transition-all hover:-translate-y-1 hover:shadow-blue-900/50">
        無料で相談する
      </a>
    </div>
  </section>


</Layout>

<style>
  /* --- アニメーションの定義 --- */

  /* 1. オーロラのように動く（blob） */
  @keyframes blob {
    0% { transform: translate(0px, 0px) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
    100% { transform: translate(0px, 0px) scale(1); }
  }
  .animate-blob {
    animation: blob 7s infinite;
  }
  .animation-delay-2000 {
    animation-delay: 2s;
  }
  .animation-delay-4000 {
    animation-delay: 4s;
  }

  /* 2. ふわふわ浮く（float） */
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
    100% { transform: translateY(0px); }
  }
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  /* 3. カーソルの点滅 */
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  .animate-blink {
    animation: blink 1s step-end infinite;
  }

  /* 4. ふわっと現れる */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0; /* 初期状態は隠す */
  }
  .delay-100 { animation-delay: 0.1s; }
  .delay-200 { animation-delay: 0.2s; }
</style>

<script>
  // タイマーのIDを管理する変数（二重起動防止用）
  let typeTimeoutId: number | undefined;

  // astro:page-load は、最初の表示＋ページ移動して戻ってきた時にも実行されます
  document.addEventListener('astro:page-load', () => {
    
    // 1. タイプライターを表示する場所を探す
    const textElement = document.querySelector('.typewriter') as HTMLElement | null;
    
    // もしこのページにタイプライター要素がなければ何もしない（他のページでのエラー防止）
    if (!textElement) return;

    // 2. 変数の初期化
    const texts = ["加速させる", "変革する", "創造する"];
    let textIndex = 0;
    let charIndex = 0;
    let isDeleting = false;

    // 3. 前のループが残っていたら止める（重要！）
    if (typeTimeoutId) clearTimeout(typeTimeoutId);

    // 4. タイプライター関数
    function type() {
      // 実行する瞬間に、まだその要素が画面にあるかチェック
      // (別のページに移動していたら停止させる)
      if (!textElement || !document.body.contains(textElement)) return;

      const currentText = texts[textIndex];
      
      if (isDeleting) {
        textElement.textContent = currentText.substring(0, charIndex - 1);
        charIndex--;
      } else {
        textElement.textContent = currentText.substring(0, charIndex + 1);
        charIndex++;
      }

      let typeSpeed = isDeleting ? 100 : 200;

      if (!isDeleting && charIndex === currentText.length) {
        // 打ち終わったら少し待機
        typeSpeed = 2000;
        isDeleting = true;
      } else if (isDeleting && charIndex === 0) {
        // 消し終わったら次の言葉へ
        isDeleting = false;
        textIndex = (textIndex + 1) % texts.length;
        typeSpeed = 500;
      }

      // 次の動作を予約し、その予約IDを保存しておく
      typeTimeoutId = setTimeout(type, typeSpeed) as unknown as number;
    }

    // 5. スタート！
    type();
  });
</script>