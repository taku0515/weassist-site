---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const works = await getCollection('works', ({ data }) => !data.draft);
  return works.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// WorkCard と同じ配色マップ（Tailwind JIT のため静的に列挙）
const ACCENTS: Record<string, string> = {
  blue: 'from-blue-600 to-cyan-500',
  purple: 'from-purple-600 to-fuchsia-500',
  emerald: 'from-emerald-600 to-teal-500',
  cyan: 'from-cyan-600 to-sky-500',
  amber: 'from-amber-500 to-orange-500',
  rose: 'from-rose-500 to-pink-500',
};
const gradient = ACCENTS[entry.data.accent] ?? ACCENTS.blue;
---

<Layout title={`${entry.data.title} | 実績`} description={entry.data.summary}>

  <section class={`relative bg-gradient-to-br ${gradient} text-white py-24 overflow-hidden`}>
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-20"></div>
    <div class="absolute inset-0 bg-slate-900/30"></div>
    <div class="container mx-auto px-6 max-w-4xl relative z-10">
      <span class="inline-block px-3 py-1 rounded-full bg-white/90 text-slate-800 text-xs font-bold mb-6">
        {entry.data.category}
      </span>
      <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-6 md:drop-shadow-md">
        {entry.data.title}
      </h1>
      <div class="flex flex-wrap gap-2">
        {entry.data.tech.map((t) => (
          <span class="px-3 py-1 rounded-full bg-white/15 border border-white/30 text-white text-xs font-semibold md:backdrop-blur-sm">
            {t}
          </span>
        ))}
      </div>
    </div>
  </section>

  {entry.data.image && (
    <section class="bg-slate-950">
      <div class="container mx-auto px-6 max-w-4xl relative z-20 -mt-12">
        <div class="rounded-xl overflow-hidden shadow-2xl border border-slate-700/60 bg-slate-950">
          <div class="flex items-center gap-1.5 px-4 py-3 bg-slate-900 border-b border-slate-800">
            <span class="w-3 h-3 rounded-full bg-red-400/80"></span>
            <span class="w-3 h-3 rounded-full bg-amber-400/80"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-400/80"></span>
            <span class="ml-3 text-slate-400 text-xs font-mono">実際の画面</span>
          </div>
          <img src={entry.data.image} alt={`${entry.data.title} の実際の画面`} class="w-full" />
        </div>
      </div>
    </section>
  )}

  <section class="relative py-16 bg-slate-950 overflow-hidden">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-[0.07]"></div>
    <div class="container mx-auto px-6 max-w-3xl relative z-10">
      <article class="prose prose-invert lg:prose-lg max-w-none prose-headings:font-bold prose-h2:border-l-4 prose-h2:border-cyan-400 prose-h2:pl-4">
        <Content />
      </article>

      <div class="mt-16 pt-8 border-t border-slate-800 flex flex-col md:flex-row items-center justify-between gap-6">
        <a href="/works" class="inline-flex items-center text-cyan-300 hover:text-cyan-200 font-bold">
          &larr; 実績一覧に戻る
        </a>
        <a href="/contact" class="inline-block px-8 py-4 bg-white text-slate-900 font-bold rounded-full hover:bg-blue-50 transition-all hover:-translate-y-0.5">
          同様の開発を相談する
        </a>
      </div>
    </div>
  </section>

</Layout>
