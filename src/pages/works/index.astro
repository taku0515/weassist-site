---
import Layout from '../../layouts/Layout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getCollection } from 'astro:content';

// 実績を新しい順に取得（下書きは除外）
const works = (await getCollection('works', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="実績" description="ローカルAIアシスタント、業務システム、コンテンツ自動化など、weassistの開発実績をご紹介します。">

  <section class="bg-slate-900 text-white py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-10"></div>
    <div class="hidden md:block absolute top-[-20%] right-[-10%] w-[400px] h-[400px] bg-blue-600 rounded-full blur-[120px] opacity-30"></div>
    <div class="container mx-auto px-6 relative z-10 text-center">
      <span class="text-blue-400 font-bold tracking-wider uppercase text-sm mb-2 block">Works</span>
      <h1 class="text-4xl md:text-5xl font-bold mb-4 tracking-tight">実績</h1>
      <p class="text-slate-400 text-lg max-w-2xl mx-auto">
        ローカルAI・業務システム・自動化基盤。<br class="md:hidden" />
        自ら作り、自ら使い続けているものだけを掲載しています。
      </p>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {works.map((work) => (
          <WorkCard work={work} />
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 text-center max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-6">
        「うちの業務でもできる？」に、まずお答えします
      </h2>
      <p class="text-slate-600 mb-10 leading-relaxed">
        掲載している実績はいずれも、身近な業務の困りごとから生まれたものです。<br class="hidden md:inline" />
        似た課題をお持ちでしたら、実現方法や費用感を無料でご相談いただけます。
      </p>
      <a href="/contact" class="inline-block px-10 py-5 bg-slate-900 text-white font-bold text-lg rounded-full shadow-lg hover:bg-slate-700 transition-all hover:-translate-y-1">
        無料で相談する
      </a>
    </div>
  </section>

</Layout>
