---
// 自作ミニアイコン。選ばれる理由・提供サービスの自作イラストとタッチを合わせた
// 青→シアンのグラデーション線画。汎用アイコン集(Lucide等)の置き換え用
interface Props {
  name: keyof typeof ICONS;
  class?: string;
}

const { name, class: className = 'w-8 h-8' } = Astro.props;

// アイコン本体（stroke系はグループのグラデーションを継承、fill指定の要素はアクセント）
const ICONS = {
  // 電球の中に回路ノード = 技術による発想
  innovation: `
    <circle cx="24" cy="19" r="10" />
    <path d="M20 33 h8 M21 38 h6" />
    <path d="M24 29 v-4 M24 19 v-4 M24 19 l-4.5 3 M24 19 l4.5 3" />
    <circle cx="24" cy="19" r="2.4" fill="#22d3ee" stroke="none" />
  `,
  // 盾にチェック = 品質・堅牢さ
  quality: `
    <path d="M24 6 L38 11 V22 C38 31 32 38 24 42 C16 38 10 31 10 22 V11 Z" />
    <path d="M17.5 23.5 L22 28 L30.5 18.5" />
    <circle cx="24" cy="9.5" r="1.8" fill="#22d3ee" stroke="none" />
  `,
  // 重なり合う2つの輪 = 対等なパートナーシップ
  partnership: `
    <circle cx="18" cy="24" r="9" />
    <circle cx="30" cy="24" r="9" />
    <circle cx="24" cy="24" r="2.4" fill="#22d3ee" stroke="none" />
  `,
  // ブラウザ画面にコードブラケット = システム開発
  system: `
    <rect x="7" y="9" width="34" height="30" rx="3.5" />
    <path d="M7 17 H41" />
    <circle cx="12.5" cy="13" r="1.6" fill="#22d3ee" stroke="none" />
    <circle cx="18" cy="13" r="1.6" fill="#22d3ee" stroke="none" />
    <path d="M19 24 L14.5 28 L19 32 M29 24 L33.5 28 L29 32 M26 22.5 L22 33.5" />
  `,
  // つながるノード = ニューラルネット・AI
  ai: `
    <circle cx="12" cy="14" r="3.5" />
    <circle cx="12" cy="34" r="3.5" />
    <circle cx="25" cy="24" r="4.5" />
    <circle cx="38" cy="24" r="3.5" />
    <path d="M15 16 L21 21.5 M15 32 L21 26.5 M29.5 24 H34.5" />
    <circle cx="25" cy="24" r="1.8" fill="#22d3ee" stroke="none" />
  `,
  // 曲がりながら上っていくルート = 変革への道筋
  dx: `
    <path d="M10 39 C19 39 15 24 24 24 C33 24 29 9 38 9" />
    <path d="M32.5 9 H38 V14.5" />
    <circle cx="10" cy="39" r="2.4" fill="#22d3ee" stroke="none" />
  `,
  // 吹き出し = 無料相談
  consult: `
    <path d="M10 10 H38 a4 4 0 0 1 4 4 V26 a4 4 0 0 1 -4 4 H26 L18 38 V30 H10 a4 4 0 0 1 -4 -4 V14 a4 4 0 0 1 4 -4 Z" transform="translate(0 1)" />
    <circle cx="17" cy="21" r="1.8" fill="#22d3ee" stroke="none" />
    <circle cx="24" cy="21" r="1.8" fill="#22d3ee" stroke="none" />
    <circle cx="31" cy="21" r="1.8" fill="#22d3ee" stroke="none" />
  `,
  // 芽吹き = スモールスタート
  'small-start': `
    <path d="M24 41 V26" />
    <path d="M24 28 C24 20 18.5 17.5 11.5 17.5 C11.5 25.5 17 28 24 28 Z" />
    <path d="M24 23 C24 15.5 29.5 13 36.5 13 C36.5 21 31 23.5 24 23.5 Z" />
    <circle cx="24" cy="41" r="2.4" fill="#22d3ee" stroke="none" />
  `,
  // 書面とチェック = 範囲・費用の明示
  scope: `
    <path d="M12 8 H32 L36 12 V40 H12 Z" />
    <path d="M17 17 H29 M17 23 H29 M17 29 H23" />
    <circle cx="30" cy="32" r="6.5" fill="#fff" />
    <path d="M27.5 32 L29.5 34 L33 30.5" />
  `,
} as const;
---

<svg viewBox="0 0 48 48" fill="none" class={className} aria-hidden="true">
  <defs>
    <linearGradient id={`wa-grad-${name}`} x1="6" y1="6" x2="42" y2="42" gradientUnits="userSpaceOnUse">
      <stop stop-color="#2563eb" />
      <stop offset="1" stop-color="#22d3ee" />
    </linearGradient>
  </defs>
  <g
    stroke={`url(#wa-grad-${name})`}
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={ICONS[name]}
  />
</svg>
