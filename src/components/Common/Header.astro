---
// ▼ データをインポート
import { SITE_DATA } from '../../data/site';

const navItems = [
  // 「ホーム」はWindowsのYu Gothic UIだと仮名が字ごとに違う幅で詰められ、
  // 「ホ」と「ム」の大きさが揃わないため、ラテン文字の「TOP」にしている。
  // 同じリンク先を指すフッターとパンくずの表記もこれに合わせること
  { label: "TOP", href: "/" },
  { label: "事業内容", href: "/services" },
  { label: "AI顧問", href: "/advisor" },
  { label: "会社紹介", href: "/company" },
  { label: "実績", href: "/works" },
  { label: "お知らせ", href: "/news" },
  { label: "ブログ", href: "https://web.weassist.jp" },
  //{ label: "お問い合わせ", href: "/contact" },
];

const logoText = SITE_DATA.nameEn?.replace(' Inc.', '') || SITE_DATA.name;
---

<header 
  id="main-header" 
  class="fixed top-0 left-0 w-full z-50 transition-transform duration-300 -translate-y-full"
>
  {/* backdrop-blurはスクロール毎に再描画が走りスマホで重いため、モバイルはほぼ不透明の紺で代替 */}
  <div id="header-bg" class="absolute inset-0 bg-slate-900 md:bg-slate-900/70 md:backdrop-blur-md shadow-md shadow-slate-950/40 border-b border-slate-800/60 transition-opacity duration-500"></div>

  <div class="container mx-auto px-6 h-20 flex items-center justify-between relative z-50">

    <a href="/" class="hidden md:block text-2xl font-bold text-white tracking-tighter hover:opacity-70 transition-opacity duration-300">
      {logoText}
      <span class="text-cyan-400">.</span>
    </a>

    <a href="/" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-xl font-bold text-white tracking-tighter md:hidden">
      {logoText}
      <span class="text-cyan-400">.</span>
    </a>

    <nav class="hidden md:block">
      <ul class="flex items-center gap-8">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="text-sm font-bold text-slate-200 hover:text-cyan-300 transition-colors">
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a href="/contact" class="px-5 py-2 bg-white text-slate-900 text-sm font-bold rounded-full hover:bg-cyan-50 transition-colors">
            Contact
          </a>
        </li>
      </ul>
    </nav>

    <button
      id="menu-btn"
      class="md:hidden flex flex-col gap-1.5 relative p-1 ml-auto"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="w-6 h-0.5 bg-slate-200 transition-all duration-300 origin-center"></span>
      <span class="w-6 h-0.5 bg-slate-200 transition-all duration-300 origin-center"></span>
      <span class="w-6 h-0.5 bg-slate-200 transition-all duration-300 origin-center"></span>
    </button>
  </div>

  {/*
    閉じている間は inert を付ける。opacity-0 だけでは画面に見えないままキーボードと
    スクリーンリーダーから到達できてしまい、閉じたメニューの項目にフォーカスが入る。
    （display:none にすると開閉のフェードが効かないので inert を使う）
  */}
  <div id="mobile-menu" inert class="fixed inset-0 bg-slate-950 z-40 flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-500 md:hidden">
    {navItems.map((item) => (
      <a href={item.href} class="text-xl font-bold text-slate-200 hover:text-cyan-300">
        {item.label}
      </a>
    ))}
    <a href="/contact" class="px-8 py-3 bg-white text-slate-900 text-xl font-bold rounded-full hover:bg-cyan-50 transition-colors">
      Contact
    </a>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const header = document.getElementById('main-header');
    const headerBg = document.getElementById('header-bg');
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const spans = menuBtn?.querySelectorAll('span');
    if (!header || !menuBtn || !mobileMenu || !spans) return;

    let isMenuOpen = false;

    // スクロール制御
    // トップページ: ヒーロー演出のため100pxスクロールするまで隠す
    // それ以外のページ: 縦が短くてもナビに戻れるよう、常に表示する
    const handleScroll = () => {
      if (isMenuOpen) return;
      const isHome = location.pathname === '/';
      if (!isHome || window.scrollY > 100) {
        header.classList.remove('-translate-y-full');
      } else {
        header.classList.add('-translate-y-full');
      }
    };

    handleScroll();
    // scroll は多発するので passive で登録する（スクロールを妨げない）
    window.addEventListener('scroll', handleScroll, { passive: true });

    // トップページで隠れている間にキーボードでヘッダー内へ入ってきたら、必ず表示に戻す。
    // 画面外のリンクに見えないままフォーカスが移るのを防ぐ
    const revealOnFocus = () => header.classList.remove('-translate-y-full');
    header.addEventListener('focusin', revealOnFocus);

    const setMenu = (open: boolean) => {
      isMenuOpen = open;

      // 閉じている間は inert でキーボード・支援技術から切り離す（見えない項目にフォーカスが入らない）
      mobileMenu.inert = !open;
      mobileMenu.classList.toggle('opacity-0', !open);
      mobileMenu.classList.toggle('pointer-events-none', !open);

      // 開いている間はヘッダー背景を透かして、メニュー面の最上部を見せる
      headerBg?.classList.toggle('opacity-0', open);

      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');

      // ハンバーガー → ✕ のアニメーション
      spans[0].classList.toggle('rotate-45', open);
      spans[0].classList.toggle('translate-y-2', open);
      spans[1].classList.toggle('opacity-0', open);
      spans[2].classList.toggle('-rotate-45', open);
      spans[2].classList.toggle('-translate-y-2', open);

      // 背面がスクロールしてしまうのを防ぐ
      document.body.classList.toggle('overflow-hidden', open);

      if (open) header.classList.remove('-translate-y-full');
    };

    menuBtn.addEventListener('click', () => setMenu(!isMenuOpen));

    // Escape で閉じられるようにする（開いた本人が戻れる経路を必ず用意する）
    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isMenuOpen) {
        setMenu(false);
        menuBtn.focus();
      }
    };
    document.addEventListener('keydown', onKeydown);

    // 画面遷移でこのDOMが捨てられるとき、windowとdocumentに残る購読を必ず外す
    // （View Transitionsは astro:page-load ごとに再実行されるため、外さないと積み上がる）
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('scroll', handleScroll);
        document.removeEventListener('keydown', onKeydown);
        document.body.classList.remove('overflow-hidden');
      },
      { once: true }
    );

    // 遷移直後は必ず閉じた状態から始める
    setMenu(false);
  });
</script>