{/*
  隠れている間は inert を付ける。opacity-0 だけだと画面に見えないままキーボードから
  フォーカスが当たり、「どこにフォーカスがあるのか分からない」状態になる。
*/}
<button
  id="scroll-to-top"
  aria-label="ページの先頭へ戻る"
  inert
  class="fixed bottom-8 right-8 z-40 p-4 bg-blue-800 text-white rounded-full shadow-lg cursor-pointer opacity-0 translate-y-10 transition-all duration-300 hover:bg-blue-600 hover:shadow-xl hover:-translate-y-1 pointer-events-none"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
  </svg>
</button>

<script>
  document.addEventListener('astro:page-load', () => {
    const scrollBtn = document.getElementById('scroll-to-top') as HTMLButtonElement | null;
    if (!scrollBtn) return;

    const HIDDEN = ['opacity-0', 'translate-y-10', 'pointer-events-none'];
    let shown = false;

    const toggleVisibility = () => {
      // 300px以上スクロールしたら表示
      const next = window.scrollY > 300;
      if (next === shown) return;
      shown = next;
      scrollBtn.classList.toggle('opacity-0', !next);
      scrollBtn.classList.toggle('translate-y-10', !next);
      scrollBtn.classList.toggle('pointer-events-none', !next);
      scrollBtn.inert = !next;
    };

    const scrollToTop = () => {
      // 「動きを減らす」設定の人には瞬間移動にする
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    };

    // 初期状態を現在のスクロール位置に合わせる（遷移直後にページ途中から始まる場合がある）
    scrollBtn.classList.add(...HIDDEN);
    scrollBtn.inert = true;
    toggleVisibility();

    window.addEventListener('scroll', toggleVisibility, { passive: true });
    scrollBtn.addEventListener('click', scrollToTop);

    // 遷移でこのDOMが捨てられるとき、windowに残る購読を外す
    document.addEventListener(
      'astro:before-swap',
      () => window.removeEventListener('scroll', toggleVisibility),
      { once: true }
    );
  });
</script>
