---
import { SITE_DATA } from '../../data/site';

// SITE は末尾スラッシュ付き（'https://weassist.jp/'）。
// 文字列連結すると `//favicon.svg` のような二重スラッシュになるため、必ず new URL で組み立てる。
const abs = (path: string) => new URL(path, import.meta.env.SITE).href;
---

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  // weassist は個人事業のため Corporation（法人）は使わない。
  // LocalBusiness系は実店舗が前提で番地まで求められるため、汎用の Organization を宣言する
  "@type": "Organization",
  "name": SITE_DATA.name,
  "url": abs('/'),
  // 構造化データのロゴはラスタ画像が推奨。実在するPNGを指すこと（過去に404のURLを宣言していた）
  "logo": abs('/logo/logo-512.png'),
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": SITE_DATA.phone,
    "contactType": "customer service",
    "areaServed": "JP",
    "availableLanguage": "Japanese"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "浅草",
    "addressLocality": "台東区",
    "addressRegion": "東京都",
    "addressCountry": "JP"
  },
  "email": SITE_DATA.email,
  "founder": { "@type": "Person", "name": SITE_DATA.president }
  // sameAs（公式SNS）は運用中のアカウントができたら追加する。
  // 実在しないURLを書くと誤った情報を検索エンジンに宣言することになるため空にしている
})} />