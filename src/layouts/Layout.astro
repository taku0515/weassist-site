---
import '../styles/global.css';

// 作成したコンポーネントをインポート
import Header from '../components/Common/Header.astro';
import Footer from '../components/Common/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import ScrollToTop from '../components/Common/ScrollToTop.astro';
import Schema from '../components/Common/Schema.astro';

// ▼【重要】サイトの基本情報を読み込み
import { SITE_DATA } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title,
  description,
  image = "/og-image.png"
} = Astro.props;

// ▼【ロジック変更】ここでタイトルと説明文を自動生成します
// ページごとのタイトルがあれば「ページ名 | 会社名」、なければ「会社名」のみ
const pageTitle = title ? `${title} | ${SITE_DATA.name}` : SITE_DATA.name;

// 説明文も同様、ページ指定がなければサイト共通のものを使う
const pageDescription = description || SITE_DATA.description;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// OGP画像は必ず絶対URL（SNS側は相対パスを解決してくれない）。
// 基準は Astro.site に固定する（Astro.url はビルド環境によって localhost になり得るため）
const ogImageURL = new URL(image, Astro.site);

// トップページはヒーローを画面いっぱいに見せるため余白なし。
// それ以外はヘッダー常時表示（h-20 = 80px）のぶんコンテンツを下げる
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="ja">
  <head>
    <Schema />
    <ClientRouter />
    {/* JS有効時のみ演出用CSSを効かせるためのフラグ（JS無効でも全コンテンツが見える保険） */}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {/*
      ファビコンはPNG。元のロゴSVG（1449px相当のトレースパス・465KB）はタブ表示には過剰で、
      全ページで読み込むには重すぎたため実サイズのPNGに置き換えている。
      原本は src/assets/logo-master.svg（配信されないがリポジトリには残す）。
    */}
    <link rel="icon" type="image/png" sizes="32x32" href="/logo/favicon-32.png" />
    <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    
    <link rel="canonical" href={canonicalURL} />

    {/* OGP画像は public/og-image.png（1200x630）。
        寸法を明示しておくとLINEやFacebookが初回取得時から正しい比率で描画できる */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_DATA.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    {/* ページ固有のhead追記用（preload等） */}
    <slot name="head" />

    {/*
      Webフォントは読み込まない。
      以前 Inter と Noto Sans JP を Google Fonts から同期読み込みしていたが、
      tailwind.config.js に fontFamily の指定がなく、CSSのどこからも参照されていなかった。
      実測（CDPで描画に使われたフォントを確認）でも見出しは Yu Gothic UI、
      等幅は Consolas と、OS標準フォントが使われていた。
      つまり表示に一切影響しないまま、描画をブロックするリクエストだけが増えていた。

      Inter / Noto Sans JP を実際に使いたくなった場合は、
      tailwind.config.js の theme.extend.fontFamily に登録したうえで読み込みを戻すこと
      （そのときは _headers のCSPに fonts.googleapis.com / fonts.gstatic.com も戻す）。
    */}


    {/*
      アクセス解析はCloudflare Pagesの組み込みWeb Analyticsを使用（配信時にビーコンを自動注入）。
      このリポジトリに計測タグは置かないこと（自前で追加すると二重計測になる）。
      View Transitions遷移はビーコンのSPAモード（既定で有効）がpushStateを拾って計測する。
    */}
  </head>
  <body class="font-sans text-slate-800 antialiased flex flex-col min-h-screen">
    
    <Header />

    <main class={`grow ${isHome ? '' : 'pt-20'}`}>
      <slot />
    </main>

    <Footer />
    <ScrollToTop />
  </body>
</html>