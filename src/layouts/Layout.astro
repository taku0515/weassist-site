---
import '../styles/global.css';

// 作成したコンポーネントをインポート
import Header from '../components/Common/Header.astro';
import Footer from '../components/Common/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import ScrollToTop from '../components/Common/ScrollToTop.astro';
import Schema from '../components/Common/Schema.astro';

// ▼【重要】サイトの基本情報を読み込み
import { SITE_DATA } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title,
  description,
  image = "/og-image.png"
} = Astro.props;

// ▼【ロジック変更】ここでタイトルと説明文を自動生成します
// ページごとのタイトルがあれば「ページ名 | 会社名」、なければ「会社名」のみ
const pageTitle = title ? `${title} | ${SITE_DATA.name}` : SITE_DATA.name;

// 説明文も同様、ページ指定がなければサイト共通のものを使う
const pageDescription = description || SITE_DATA.description;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// トップページはヒーローを画面いっぱいに見せるため余白なし。
// それ以外はヘッダー常時表示（h-20 = 80px）のぶんコンテンツを下げる
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="ja">
  <head>
    <Schema />
    <ClientRouter />
    {/* JS有効時のみ演出用CSSを効かせるためのフラグ（JS無効でも全コンテンツが見える保険） */}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logo/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />

    {/* ページ固有のhead追記用（preload等） */}
    <slot name="head" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet">
  
    {/*
      アクセス解析はCloudflare Pagesの組み込みWeb Analyticsを使用（配信時にビーコンを自動注入）。
      このリポジトリに計測タグは置かないこと（自前で追加すると二重計測になる）。
      View Transitions遷移はビーコンのSPAモード（既定で有効）がpushStateを拾って計測する。
    */}
  </head>
  <body class="font-sans text-slate-800 antialiased flex flex-col min-h-screen">
    
    <Header />

    <main class={`grow ${isHome ? '' : 'pt-20'}`}>
      <slot />
    </main>

    <Footer />
    <ScrollToTop />
  </body>
</html>